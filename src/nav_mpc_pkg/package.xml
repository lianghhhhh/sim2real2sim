<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>nav_mpc_pkg</name>
  <version>0.0.0</version>
  <description>Point-to-point navigation: Nav2 planner_server plans an obstacle-free path to a goal (Foxglove / RViz goal pose), sensor_mpc_pkg's MPC tracks it on sensor localization, and a manager node stops the car and replans when the LiDAR sees a new obstacle on the path ahead.</description>
  <maintainer email="selenahuang0218@gmail.com">liangh</maintainer>
  <license>MIT</license>

  <depend>rclpy</depend>
  <depend>tf2_ros</depend>
  <depend>action_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>nav2_msgs</depend>
  <depend>sensor_msgs</depend>
  <depend>std_msgs</depend>
  <depend>std_srvs</depend>
  <depend>visualization_msgs</depend>
  <depend>python3-numpy</depend>
  <depend>python3-yaml</depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <!-- Nav2: 只用地圖 / 規劃器 / costmap (控制器是 MPC)。sim2real2sim:v3 沒有, 見根目錄 Dockerfile -->
  <exec_depend>nav2_map_server</exec_depend>
  <exec_depend>nav2_planner</exec_depend>
  <exec_depend>nav2_smac_planner</exec_depend>
  <exec_depend>nav2_costmap_2d</exec_depend>
  <exec_depend>nav2_lifecycle_manager</exec_depend>
  <exec_depend>sensor_mpc_pkg</exec_depend>
  <exec_depend>car_loc_lidar</exec_depend>

  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
