<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>car_loc_wheel</name>
  <version>1.0.0</version>
  <description>IMU + 四輪輪速的航位推算。輪速給前進速度 (誤差從時間的二次式變成距離的一次式), 陀螺儀給角速度 (skid-steer 不能用輪速差算 yaw), 加速度計在打滑時撐住估計。7 維 EKF, 側向速度是結構性的 0。不吃 LiDAR, 不吃相機, 不吃地圖。</description>
  <maintainer email="selenahuang0218@gmail.com">liangh</maintainer>
  <license>MIT</license>

  <depend>rclpy</depend>
  <depend>sensor_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>std_srvs</depend>
  <depend>tf2_ros</depend>
  <depend>python3-numpy</depend>

  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <!-- 只有 launch 的 teleop:=true 會用到 (拿來開車, 跟定位無關) -->
  <exec_depend>car_teleop</exec_depend>

  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
