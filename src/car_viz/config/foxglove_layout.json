        "/odom": { "visible": true },
        "/camera_loc/pose": { "visible": true },
        "/lidar_loc/pose": { "visible": true },
        "/imu_loc/pose": { "visible": false },
        "/wheel_loc/pose": { "visible": true },
        "/fusion_loc/pose": { "visible": true }
      },
      "layers": {}
    },
    "Image!yolo": {
      "cameraState": {},
      "imageMode": { "imageTopic": "/camera_loc/detections/compressed" }
    },
    "Teleop!drive": {
      "topic": "/cmd_vel",
      "publishRate": 10,
      "upButton": { "field": "linear-x", "value": 0.35 },
      "downButton": { "field": "linear-x", "value": -0.35 },
      "leftButton": { "field": "angular-z", "value": 0.6 },
      "rightButton": { "field": "angular-z", "value": -0.6 }
