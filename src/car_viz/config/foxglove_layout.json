        { "value": "/lidar_loc/odom.pose.pose.position.x", "enabled": true, "timestampMethod": "receiveTime" },
        { "value": "/wheel_loc/odom.pose.pose.position.x", "enabled": true, "timestampMethod": "receiveTime" },
        { "value": "/fusion_loc/odom.pose.pose.position.x", "enabled": true, "timestampMethod": "receiveTime" }
