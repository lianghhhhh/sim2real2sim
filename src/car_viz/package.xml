<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>car_viz</name>
  <version>1.0.0</version>
  <description>開一個 WebSocket 給 Foxglove Studio 連 (foxglove_bridge, 沒裝就退回 rosbridge_server), 附一份看五條定位線的現成版面, 並把 /rgb 壓成 JPEG 免得把 bridge 塞爆。</description>
  <maintainer email="selenahuang0218@gmail.com">liangh</maintainer>
  <license>MIT</license>

  <!-- 兩個 bridge 擇一即可, launch 會自動挑裝了的那個 (foxglove_bridge 優先)。 -->
  <exec_depend>foxglove_bridge</exec_depend>
  <exec_depend>rosbridge_server</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>

  <!-- image_compressor (/rgb -> /rgb/compressed)。cv2 用映像檔裡 pip 裝的
       opencv-contrib-python, 跟 car_loc_camera 一樣不列 python3-opencv ——
       rosdep 會去 apt 裝另一份 cv2, 兩份打架。 -->
  <depend>rclpy</depend>
  <depend>sensor_msgs</depend>
  <depend>python3-numpy</depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
