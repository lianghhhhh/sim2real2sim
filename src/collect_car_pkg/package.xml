<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>collect_car_pkg</name>
  <version>0.0.0</version>
  <description>動態模型訓練資料的激發駕駛 (Isaac 模擬, 輪速控制)</description>
  <maintainer email="selenahuang0218@gmail.com">liangh</maintainer>
  <license>TODO: License declaration</license>

  <depend>rclpy</depend>
  <depend>nav_msgs</depend>
  <depend>sensor_msgs</depend>
  <depend>std_msgs</depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <!-- collect_car.launch.py 用它們的 collect_data_node 與 actuator_model -->
  <exec_depend>calibrate_env_pkg</exec_depend>
  <exec_depend>car_teleop</exec_depend>

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
